# Copy to .env.local and fill in. .env*.local is gitignored.

# ── Transactional email (contact form) ──────────────────────────────────────
# Contact-form submissions send a notification to the team and a confirmation
# to the enquirer. Delivery is via Resend (https://resend.com).
#
# Setup:
#   1. Create a Resend account and add the domain `itzdigital.co`.
#   2. Add the DNS records Resend gives you (SPF, DKIM, and a Return-Path CNAME)
#      and wait for the domain to show "Verified".
#   3. Create an API key and paste it below.
# Until the domain is verified, sends will 403 and the failure is logged; the
# form still returns success so no lead is lost.

RESEND_API_KEY=

# Optional overrides (defaults shown):
# EMAIL_FROM="ITZ Digital <info@itzdigital.co>"
# EMAIL_REPLY_TO="info@itzdigital.co"
# CONTACT_NOTIFY_TO="production@itzontarget.com"

# ── Content generation (see README §7, §12, §14) ────────────────────────────
# Used by: `npm run generate:content` locally, the daily-content GitHub
# Actions workflow (as repository secrets — see README §12), AND — this is
# the part that's easy to miss — the deployed /api/studio/generate route
# behind the Sanity Studio's "Generate with AI" button (README §14), which
# runs live on Vercel and needs its OWN copy of whichever key(s) you use set
# as a normal Vercel env var. The GitHub Actions secret does not cover this;
# they're separate places even though the variable names are identical.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Media host for imported blog images (optional — see README §5) ──────────
# NEXT_PUBLIC_MEDIA_BASE=https://cdn.itzdigital.co/uploads

# ── /admin content studio (see README §8) ───────────────────────────────────
# Gates /admin behind HTTP Basic Auth — your colleague's browser will prompt
# for these once and remember them. Required in production; without them the
# admin panel 503s rather than sit open. Pick your own values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Lets the deployed /admin app read and write THIS repo on GitHub — commit an
# uploaded sheet, trigger the daily-content workflow, list/merge/close the
# pull requests it opens. Create a fine-grained Personal Access Token at
# github.com/settings/tokens, scoped to only this repository, with
# "Contents", "Pull requests" and "Actions" set to Read & write. This is
# DIFFERENT from the GITHUB_TOKEN GitHub injects automatically inside an
# Actions run — that one needs no setup and isn't this variable.
GITHUB_API_TOKEN=
GITHUB_REPO=production-wq/itz-website
# The branch PRs are opened against and merged into — confirm this actually
# matches what's set as Production in Vercel before relying on the pipeline.
GITHUB_BASE_BRANCH=redesign-refresh

# ── IndexNow (optional — see README §8) ─────────────────────────────────────
# Pings Bing/Yandex the moment a post or location page is merged. Google has
# no equivalent public API; the admin dashboard links to Search Console's
# manual "Request indexing" instead. The key below must match the filename of
# the key file already published at public/<key>.txt.
# INDEXNOW_KEY=51480d415fc51d69b3d02e0f4f46bd8f

# ── Sanity Studio sync (optional — see README §13) ──────────────────────────
# Lets a colleague write posts directly in the ITZ Digital Sanity Studio
# (../studio-itz-digital, a separate app) as a second way in alongside
# /admin/new. Vercel needs only the webhook secret below; the rest are
# GitHub Actions repository secrets (scripts/sync-sanity-posts.mjs runs
# inside the sanity-sync.yml workflow, not on Vercel).
#
#   GitHub Actions secrets: SANITY_PROJECT_ID (yu3obcx8), SANITY_DATASET
#   (production), SANITY_API_TOKEN (only if the dataset is private)
#
# Vercel env var — verifies that a webhook POST to /api/sanity-webhook really
# came from Sanity. Generate any random string and set the SAME value when
# creating the webhook in sanity.io/manage → API → Webhooks.
# SANITY_WEBHOOK_SECRET=

# ── "Generate with AI" Studio button (see README §14) ───────────────────────
# Backend for the AI-draft button inside the Sanity Studio itself (separate
# from the sync above — this one runs live, on demand, from a button click).
# Set this to the SAME value baked into the Studio's build as
# SANITY_STUDIO_AI_SECRET (../studio-itz-digital/.env) — it's how this route
# knows a request actually came from the Studio and not a random POST.
STUDIO_AI_SECRET=
